        "ref": "master",
        "path": "extra-files/compiled/SSDT-PLUG-DRTNIA.aml"
      },
      "notes": "XCPM/CPU power management (variante DRTNIA, Dortania)."
    },
    {
      "id": "ssdt_ec_usbx",
      "kind": "aml",
      "required": true,
      "target": "OC/ACPI/SSDT-EC-USBX-DESKTOP.aml",
      "provenance": "default",
      "source": {
        "type": "github_raw",
        "repo": "dortania/Getting-Started-With-ACPI",
        "ref": "master",
        "path": "extra-files/compiled/SSDT-EC-USBX-DESKTOP.aml"
      },
      "notes": "Embedded Controller + USB power (variante desktop, Dortania)."
    },
    {
      "id": "config_plist",
      "kind": "generated",
      "required": true,
      "target": "OC/config.plist",
      "provenance": "verified",
      "source": {
        "type": "generated",
        "generator": "config.plist"
      },
      "notes": "Generato dal motore a partire dal profilo (DeviceProperties, boot-args, SMBIOS)."
    },
    {
      "id": "readme_efi",
      "kind": "generated",
      "required": true,
      "scope": "output",
      "target": "README_EFI.txt",
      "provenance": "verified",
      "source": {
        "type": "generated",
        "generator": "readme"
      },
      "notes": "Riepilogo componenti + fonti + sha256 (provenance ledger)."
    },
    {
      "id": "nvmefix",
