        "type": "github_release",
        "repo": "acidanthera/AppleALC",
        "tag": "latest",
        "asset": "AppleALC-*-RELEASE.zip"
      },
      "notes": "Audio ALC671 (layout-id di default 11, configurato in config.plist)."
