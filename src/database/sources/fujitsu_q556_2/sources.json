    {
      "id": "opencanopy",
      "kind": "efi_binary",
      "required": false,
      "optional_group": "optional_drivers",
      "target": "OC/Drivers/OpenCanopy.efi",
      "provenance": "default",
      "source": {
        "type": "github_release",
        "repo": "acidanthera/OpenCorePkg",
        "tag": "latest",
        "asset": "OpenCore-*-RELEASE.zip",
        "path_in_archive": "X64/EFI/OC/Drivers/OpenCanopy.efi"
