{
  "manifest_version": 1,
  "profile_id": "fujitsu_q556_2",
  "name": "Sources database — Fujitsu Esprimo Q556/2",
  "description": "Tutti i file della EFI e le fonti ufficiali da cui scaricarli. provenance 'default' = fonte canonica ufficiale non ancora confermata dal maintainer; 'verified' = fonte confermata. I pin di versione/sha256 vanno aggiunti quando le fonti vengono verificate.",
  "components": [
    {
      "id": "opencore",
      "kind": "efi_binary",
      "required": true,
      "target": "OC/OpenCore.efi",
      "min_size": 50000,
      "provenance": "default",
      "source": {
        "type": "github_release",
        "repo": "acidanthera/OpenCorePkg",
        "tag": "latest",
        "asset": "OpenCore-*-RELEASE.zip",
        "path_in_archive": "X64/EFI/OC/OpenCore.efi"
      },
      "notes": "Bootloader OpenCore (Acidanthera). L'asset RELEASE contiene l'intera struttura EFI X64."
    },
    {
      "id": "bootx64",
      "kind": "efi_binary",
      "required": true,
      "target": "BOOT/BOOTx64.efi",
      "min_size": 20000,
      "provenance": "default",
      "source": {
        "type": "github_release",
        "repo": "acidanthera/OpenCorePkg",
        "tag": "latest",
        "asset": "OpenCore-*-RELEASE.zip",
        "path_in_archive": "X64/EFI/BOOT/BOOTx64.efi"
      },
      "notes": "Stesso archivio di OpenCore: un solo download per tutti i binari OpenCorePkg."
    },
    {
      "id": "hfsplus",
      "kind": "efi_binary",
      "required": true,
      "target": "OC/Drivers/HfsPlus.efi",
      "min_size": 20000,
      "provenance": "default",
      "source": {
        "type": "github_release",
        "repo": "acidanthera/OpenCorePkg",
        "tag": "latest",
        "asset": "OpenCore-*-RELEASE.zip",
        "path_in_archive": "X64/EFI/OC/Drivers/HfsPlus.efi"
      },
      "notes": "Driver HFS+ per leggere il volume di avvio macOS."
    },
    {
      "id": "openruntime",
      "kind": "efi_binary",
      "required": true,
      "target": "OC/Drivers/OpenRuntime.efi",
      "min_size": 10000,
      "provenance": "default",
      "source": {
        "type": "github_release",
        "repo": "acidanthera/OpenCorePkg",
        "tag": "latest",
        "asset": "OpenCore-*-RELEASE.zip",
        "path_in_archive": "X64/EFI/OC/Drivers/OpenRuntime.efi"
      },
      "notes": "Runtime services (NVRAM, variabili UEFI)."
    },
    {
      "id": "lilu",
      "kind": "kext",
      "required": true,
      "target": "OC/Kexts/Lilu.kext",
      "provenance": "default",
