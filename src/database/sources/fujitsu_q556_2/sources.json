      "target": "OC/Kexts/RestrictEvents.kext",
      "provenance": "default",
      "source": {
        "type": "github_release",
        "repo": "acidanthera/RestrictEvents",
        "tag": "latest",
        "asset": "RestrictEvents-*-RELEASE.zip"
      },
      "notes": "Opzionale: blocca processi/avvisi indesiderati (--include-restrict-events)."
